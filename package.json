{
  "name": "emresandikci-official-website",
  "version": "1.1.0",
  "description": "My personal website ",
  "repository": "https://github.com/emresandikci/emresandikci.com",
  "author": "emresandikci<me@emresandikci.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emresandikci/emresandikci.com/issues"
  },
  "homepage": "https://github.com/emresandikci/emresandikci.com#readme",
  "type": "module",
  "keywords": [
    "reactjs",
    "boilerplate",
    "styled-components",
    "styled-system",
    "esducad-ui",
    "kit"
  ],
  "scripts": {
    "dev": "vite --open",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "lint": "eslint --ext .js,.jsx src",
    "lint:fix": "eslint --ext .js,.jsx --fix src",
    "validate": "prettier --check \"src/**/*.{js,jsx,css,json}\" && eslint --ext .js,.jsx src"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "src/**/!(*story).{js,jsx}": [
      "pnpm format",
      "pnpm lint:fix",
      "pnpm validate"
    ]
  },
  "dependencies": {
    "esducad-ui": "https://github.com/emresandikci/esducad-ui#master",
    "prop-types": "^15.8.1",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-helmet": "^6.0.0",
    "react-router-dom": "^5.1.2",
    "styled-components": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^8.3.5",
    "@commitlint/config-conventional": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.1.7",
    "prettier": "^2.0.5",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  }
}
